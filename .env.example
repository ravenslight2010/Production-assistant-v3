# Use a disposable V3 PostgreSQL database. Never commit a real connection URL.
V3_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
# Required only for guarded first-manager setup on a fresh database.
# Generate a unique 32–256 character value outside source control.
# V3_INITIAL_MANAGER_BOOTSTRAP_CODE=
PORT=5000
V3_WORKER_HEALTH_PORT=3001
NODE_ENV=development
